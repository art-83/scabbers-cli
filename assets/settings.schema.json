{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "soulFile": {
      "type": "string",
      "minLength": 1
    },
    "browser": {
      "default": {},
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "profileDirectory": {
          "type": "string",
          "minLength": 1
        },
        "testOrigin": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "engine": {
      "default": "claude",
      "type": "string",
      "enum": ["claude", "codex"]
    },
    "engines": {
      "type": "object",
      "properties": {
        "codex": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
            },
            "effort": {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "additionalProperties": false
        },
        "claude": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
            },
            "effort": {
              "type": "string",
              "enum": ["low", "medium", "high", "xhigh", "max"]
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["codex", "claude"],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "order": {
          "default": ["codex", "claude"],
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["codex", "claude"]
          }
        },
        "cooldownSeconds": {
          "default": 300,
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      },
      "required": ["enabled", "order", "cooldownSeconds"],
      "additionalProperties": false
    },
    "workers": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "remoteEnabled": {
      "default": false,
      "type": "boolean"
    },
    "credentialKeys": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "SCABBERS_SLACK_BOT_TOKEN",
          "SCABBERS_SLACK_APP_TOKEN",
          "SCABBERS_JIRA_TOKEN",
          "SCABBERS_GITLAB_TOKEN",
          "TYPESAFE_API_KEY"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^local:[0-9a-f-]{36}$"
      }
    },
    "slack": {
      "default": {
        "channel": "C0BU8TX3NTW",
        "reportBotIds": ["B0C0B2WU7PU"]
      },
      "type": "object",
      "properties": {
        "channel": {
          "default": "C0BU8TX3NTW",
          "type": "string"
        },
        "reportBotIds": {
          "default": ["B0C0B2WU7PU"],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user": {
          "type": "string",
          "pattern": "^U[A-Z0-9]+$"
        },
        "tokenParameter": {
          "type": "string"
        },
        "appTokenParameter": {
          "type": "string"
        }
      },
      "required": ["channel", "reportBotIds"],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string"
        },
        "shifts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "enum": [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday",
                  "Sunday"
                ]
              },
              "start": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "required": ["day", "start", "end"],
            "additionalProperties": false
          }
        }
      },
      "required": ["zone", "shifts"],
      "additionalProperties": false
    },
    "jira": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "accountId": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "routingFields": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "copyReportFields": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "baseUrl",
        "email",
        "accountId",
        "project",
        "routingFields",
        "copyReportFields"
      ],
      "additionalProperties": false
    },
    "development": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "boardId": {
          "default": 28,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "column": {
          "default": "To Do",
          "type": "string",
          "minLength": 1
        },
        "pollSeconds": {
          "default": 60,
          "type": "integer",
          "minimum": 15,
          "maximum": 3600
        },
        "workflowStatuses": {
          "default": [
            "To Do",
            "Open",
            "Analysis",
            "Solution Analysis",
            "In Progress",
            "Docs & Tests",
            "Ready for Code Review"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "To Do",
              "Open",
              "Analysis",
              "Solution Analysis",
              "In Progress",
              "Docs & Tests",
              "Ready for Code Review"
            ]
          }
        },
        "transitions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "enum": [
                  "To Do",
                  "Open",
                  "Analysis",
                  "Solution Analysis",
                  "In Progress",
                  "Docs & Tests",
                  "Ready for Code Review"
                ]
              },
              "documented": {
                "type": "string",
                "enum": [
                  "To Do",
                  "Open",
                  "Analysis",
                  "Solution Analysis",
                  "In Progress",
                  "Docs & Tests",
                  "Ready for Code Review"
                ]
              },
              "validated": {
                "type": "string",
                "enum": [
                  "To Do",
                  "Open",
                  "Analysis",
                  "Solution Analysis",
                  "In Progress",
                  "Docs & Tests",
                  "Ready for Code Review"
                ]
              }
            },
            "required": ["claim", "documented", "validated"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "enabled",
        "boardId",
        "column",
        "pollSeconds",
        "workflowStatuses",
        "transitions"
      ],
      "additionalProperties": false
    },
    "gitlab": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "default": "https://gitlab.com",
          "type": "string",
          "format": "uri"
        },
        "projectId": {
          "type": "string"
        }
      },
      "required": ["baseUrl", "projectId"],
      "additionalProperties": false
    },
    "repositories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["arccanet-backend", "arccanet-frontend", "arcca-pdv"]
          },
          "path": {
            "type": "string"
          },
          "stagingUrl": {
            "type": "string",
            "format": "uri"
          },
          "stagingRef": {
            "default": "staging",
            "type": "string",
            "const": "staging"
          },
          "baseBranch": {
            "default": "master",
            "type": "string",
            "minLength": 1
          },
          "gitlabProjectId": {
            "type": "string"
          },
          "testCommand": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["name", "path", "stagingRef", "baseBranch"],
        "additionalProperties": false
      }
    },
    "skillPaths": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "historySources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aws": {
      "type": "object",
      "properties": {
        "readOnlyLogs": {
          "default": false,
          "type": "boolean"
        },
        "profile": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "required": ["readOnlyLogs"],
      "additionalProperties": false
    },
    "jevKeyParameter": {
      "type": "string"
    }
  },
  "required": [
    "paths",
    "browser",
    "version",
    "engine",
    "engines",
    "fallback",
    "workers",
    "remoteEnabled",
    "credentialKeys",
    "slack",
    "development",
    "repositories",
    "skillPaths",
    "historySources",
    "aws"
  ],
  "additionalProperties": false,
  "title": "Scabbers settings",
  "description": "Editable NOLA Scabbers settings. Runtime state and SOUL approval are persisted separately."
}
